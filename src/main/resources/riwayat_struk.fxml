<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="14" styleClass="page" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.RiwayatStrukController">
    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>

    <!-- ============ TABEL RIWAYAT ============ -->
    <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
        <Label styleClass="section-title" text="Riwayat Transaksi" />
        <TableView fx:id="tblStruk" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colResi" prefWidth="190" text="No. Resi" />
                <TableColumn fx:id="colTanggal" prefWidth="90" text="Tanggal" />
                <TableColumn fx:id="colWaktu" prefWidth="60" text="Jam" />
                <TableColumn fx:id="colItem" prefWidth="50" text="Item" />
                <TableColumn fx:id="colTotal" prefWidth="110" text="Total" />
                <TableColumn fx:id="colMetode" prefWidth="120" text="Metode" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Button onAction="#handleMuatUlang" text="Muat Ulang" />
            <Button onAction="#handleHapus" styleClass="danger" text="Hapus" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblRingkasan" styleClass="hint" text="" />
        </HBox>
    </VBox>

    <!-- ============ PREVIEW STRUK ============ -->
    <VBox spacing="10" styleClass="card" prefWidth="450" minWidth="430">
        <Label styleClass="section-title" text="Preview Struk" />
        <TextArea fx:id="txtPreview" editable="false" styleClass="struk-text" VBox.vgrow="ALWAYS"
                  promptText="Pilih transaksi di tabel untuk melihat struknya" />
    </VBox>
</HBox>
