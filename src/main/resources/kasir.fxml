<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="14" styleClass="page" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.KasirController">
    <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>

    <!-- ============ KIRI: KATALOG BARANG ============ -->
    <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
        <Label styleClass="section-title" text="Katalog Barang" />
        <TextField fx:id="txtCari" promptText="Cari nama atau kode barang..." />
        <TableView fx:id="tblKatalog" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colKatTipe" prefWidth="90" text="Tipe" />
                <TableColumn fx:id="colKatKode" prefWidth="130" text="Kode" />
                <TableColumn fx:id="colKatNama" prefWidth="190" text="Nama Barang" />
                <TableColumn fx:id="colKatHarga" prefWidth="110" text="Harga" styleClass="kanan" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Qty" />
            <Spinner fx:id="spnQty" editable="true" prefWidth="80" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleTambah" styleClass="secondary" text="Tambah ke Keranjang" />
        </HBox>
    </VBox>

    <!-- ============ KANAN: KERANJANG + PEMBAYARAN ============ -->
    <VBox spacing="10" styleClass="card" prefWidth="470" minWidth="430">
        <Label styleClass="section-title" text="Keranjang" />
        <TableView fx:id="tblKeranjang" prefHeight="200">
            <columns>
                <TableColumn fx:id="colKerNama" prefWidth="170" text="Barang" />
                <TableColumn fx:id="colKerQty" prefWidth="45" text="Qty" />
                <TableColumn fx:id="colKerHarga" prefWidth="100" text="Harga" />
                <TableColumn fx:id="colKerSubtotal" prefWidth="110" text="Subtotal" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>
        <HBox spacing="8">
            <Button onAction="#handleHapusItem" text="Hapus Item" />
            <Button onAction="#handleKosongkan" text="Kosongkan" />
        </HBox>

        <GridPane hgap="10" vgap="4" styleClass="ringkasan">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints halignment="RIGHT" />
            </columnConstraints>
            <Label text="Subtotal" GridPane.rowIndex="0" />
            <Label fx:id="lblSubtotal" text="Rp 0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Welcome Coupon" GridPane.rowIndex="1" />
            <Label fx:id="lblDiskon" text="-Rp 0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label styleClass="total-label" text="TOTAL" GridPane.rowIndex="2" />
            <Label fx:id="lblTotal" styleClass="total-label" text="Rp 0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </GridPane>
        <Label fx:id="lblInfoKupon" styleClass="hint" text="Welcome Coupon Rp 25,000 berlaku untuk belanja min. Rp 250,000" wrapText="true" />

        <Separator />

        <Label styleClass="section-title" text="Metode Pembayaran" />
        <fx:define>
            <ToggleGroup fx:id="tgMetode" />
        </fx:define>
        <HBox spacing="18">
            <RadioButton fx:id="rbTunai" selected="true" text="Tunai" toggleGroup="$tgMetode" />
            <RadioButton fx:id="rbNonTunai" text="Non-Tunai (Kartu)" toggleGroup="$tgMetode" />
        </HBox>
        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="115" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <Label text="Uang Diterima" GridPane.rowIndex="0" />
            <TextField fx:id="txtUangDiterima" promptText="mis. 1200000" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Kembalian" GridPane.rowIndex="1" />
            <Label fx:id="lblKembalian" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Nomor Kartu" GridPane.rowIndex="2" />
            <TextField fx:id="txtNomorKartu" promptText="12-19 digit angka" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Jenis Kartu" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbJenisKartu" maxWidth="Infinity" promptText="Pilih jenis kartu" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        </GridPane>

        <Region VBox.vgrow="ALWAYS" />
        <Button maxWidth="Infinity" onAction="#handleBayar" styleClass="primary" text="Bayar &amp; Cetak Struk" />
    </VBox>
</HBox>
